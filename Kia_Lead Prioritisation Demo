<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kia Sales Priority - Lead Prioritisation Demo</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary-bg: #0f0f0f;
            --secondary-bg: #1a1a1a;
            --card-bg: #252525;
            --border-color: #333333;
            --text-primary: #ffffff;
            --text-secondary: #b0b0b0;
            --accent-blue: #0066ff;
            --accent-orange: #ff9500;
            --accent-green: #22c55e;
            --accent-purple: #a855f7;
            --accent-red: #ef4444;
            --kia-red: #ff0000;
        }

        html, body {
            width: 100%;
            height: 100%;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, var(--primary-bg) 0%, #0a0a0a 100%);
            color: var(--text-primary);
        }

        .app-container {
            display: flex;
            width: 100%;
            height: 100vh;
            overflow: hidden;
            flex-direction: column;
        }

        /* NAVIGATION */
        .nav-header {
            background: linear-gradient(180deg, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 100%);
            border-bottom: 1px solid var(--border-color);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            backdrop-filter: blur(10px);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .nav-logo {
            font-size: 28px;
            font-weight: 700;
            color: var(--kia-red);
        }

        .nav-title {
            display: flex;
            flex-direction: column;
        }

        .nav-title-main {
            font-size: 18px;
            font-weight: 600;
        }

        .nav-title-sub {
            font-size: 11px;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-meta {
            text-align: right;
        }

        .nav-date {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 6px;
        }

        .nav-badge {
            display: inline-block;
            background: rgba(255, 0, 0, 0.15);
            color: var(--kia-red);
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }

        /* CONTENT */
        .content-wrapper {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            padding: 40px;
        }

        .view {
            display: none;
            animation: fadeIn 0.4s ease-in-out;
        }

        .view.active {
            display: block;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        /* MY LEADS */
        .summary-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 30px;
        }

        .summary-title {
            font-size: 32px;
            font-weight: 700;
        }

        .summary-stats {
            display: flex;
            gap: 30px;
            margin-top: 10px;
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 14px;
        }

        .stat-badge {
            display: inline-block;
            width: 12px;
            height: 12px;
            border-radius: 50%;
        }

        .stat-badge.hot { background: var(--accent-red); }
        .stat-badge.warm { background: var(--accent-orange); }
        .stat-badge.cold { background: var(--accent-blue); }

        .demo-controls {
            display: flex;
            gap: 10px;
        }

        .btn {
            padding: 10px 16px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background: transparent;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            transition: all 0.3s ease;
        }

        .btn:hover {
            border-color: var(--kia-red);
            background: rgba(255, 0, 0, 0.1);
        }

        .btn-primary {
            background: var(--kia-red);
            border-color: var(--kia-red);
            color: white;
        }

        .btn-primary:hover {
            background: #cc0000;
        }

        /* TABLE */
        .leads-table {
            width: 100%;
            border-collapse: collapse;
        }

        .leads-table th {
            padding: 16px;
            text-align: left;
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            border-bottom: 1px solid var(--border-color);
            background: rgba(0, 0, 0, 0.3);
        }

        .leads-table td {
            padding: 16px;
            border-bottom: 1px solid rgba(51, 51, 51, 0.5);
            font-size: 13px;
        }

        .leads-table tbody tr {
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .leads-table tbody tr:hover {
            background: rgba(255, 0, 0, 0.05);
        }

        .lead-name {
            font-weight: 600;
        }

        .score-cell {
            font-weight: 700;
            font-size: 16px;
            color: var(--kia-red);
        }

        .priority-badge {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 600;
        }

        .priority-badge.hot {
            background: rgba(239, 68, 68, 0.2);
            color: var(--accent-red);
        }

        .priority-badge.warm {
            background: rgba(255, 149, 0, 0.2);
            color: var(--accent-orange);
        }

        .priority-badge.cold {
            background: rgba(0, 102, 255, 0.2);
            color: var(--accent-blue);
        }

        /* LEAD 360 */
        .lead-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            padding-bottom: 30px;
            border-bottom: 1px solid var(--border-color);
            margin-bottom: 30px;
        }

        .lead-name-header {
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .lead-meta {
            font-size: 13px;
            color: var(--text-secondary);
        }

        .lead-header-right {
            text-align: right;
        }

        .score-display {
            margin-bottom: 16px;
        }

        .score-number {
            font-size: 48px;
            font-weight: 700;
            color: var(--kia-red);
            line-height: 1;
        }

        .score-label {
            font-size: 11px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .priority-display {
            display: flex;
            gap: 12px;
            align-items: center;
            justify-content: flex-end;
            margin-bottom: 16px;
        }

        .priority-badge-large {
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 700;
        }

        .priority-badge-large.hot {
            background: rgba(239, 68, 68, 0.2);
            color: var(--accent-red);
        }

        .priority-badge-large.warm {
            background: rgba(255, 149, 0, 0.2);
            color: var(--accent-orange);
        }

        .priority-badge-large.cold {
            background: rgba(0, 102, 255, 0.2);
            color: var(--accent-blue);
        }

        .recommended-action {
            background: rgba(34, 197, 94, 0.15);
            border-left: 3px solid var(--accent-green);
            padding: 12px 16px;
            border-radius: 6px;
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 12px;
        }

        .recommended-action strong {
            color: var(--accent-green);
        }

        /* CARDS */
        .category-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 30px;
        }

        .category-card {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 18px;
            border-top: 3px solid;
        }

        .category-card.blue { border-top-color: var(--accent-blue); }
        .category-card.orange { border-top-color: var(--accent-orange); }
        .category-card.green { border-top-color: var(--accent-green); }
        .category-card.purple { border-top-color: var(--accent-purple); }

        .category-label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        .category-score {
            font-size: 32px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 4px;
        }

        .category-max {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 12px;
        }

        .category-bar {
            width: 100%;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
        }

        .category-bar-fill {
            height: 100%;
            border-radius: 2px;
            transition: width 0.4s ease;
        }

        /* SECTIONS */
        .section {
            background: var(--card-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 20px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .signal-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .signal-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 6px;
        }

        .signal-text {
            font-size: 13px;
            color: var(--text-secondary);
            flex: 1;
        }

        .signal-bar {
            width: 100px;
            height: 4px;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 2px;
            overflow: hidden;
        }

        .signal-bar-fill {
            height: 100%;
            background: var(--kia-red);
        }

        .signal-points {
            font-weight: 700;
            color: var(--kia-red);
            font-size: 14px;
            white-space: nowrap;
        }

        /* JOURNEY */
        .journey-stages {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
        }

        .journey-stage {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .stage-name {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border-color);
        }

        .stage-signals {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .stage-signal {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .stage-signal.completed {
            color: var(--accent-green);
        }

        /* SIMULATION */
        .simulation-section {
            background: var(--card-bg);
            border: 2px solid var(--accent-green);
            border-radius: 10px;
            padding: 24px;
            margin-bottom: 30px;
        }

        .simulation-title {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .simulation-subtitle {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 20px;
        }

        .simulation-buttons {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .sim-button {
            padding: 12px 14px;
            border: 1px solid var(--border-color);
            border-radius: 6px;
            background: transparent;
            color: var(--text-primary);
            cursor: pointer;
            font-size: 12px;
            font-weight: 600;
            text-align: center;
            transition: all 0.3s ease;
        }

        .sim-button:hover {
            border-color: var(--accent-green);
            background: rgba(34, 197, 94, 0.1);
        }

        .sim-button.negative {
            border-color: var(--accent-red);
            color: var(--accent-red);
        }

        .sim-button.negative:hover {
            border-color: var(--accent-red);
            background: rgba(239, 68, 68, 0.1);
        }

        .feedback {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 16px;
            background: rgba(34, 197, 94, 0.15);
            border-left: 3px solid var(--accent-green);
            border-radius: 6px;
            font-size: 13px;
            color: var(--accent-green);
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .feedback.hide {
            display: none;
        }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(5px);
            z-index: 200;
            align-items: center;
            justify-content: center;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--secondary-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 32px;
            max-width: 500px;
            max-height: 80vh;
            overflow-y: auto;
        }

        .modal-close {
            float: right;
            cursor: pointer;
            font-size: 24px;
            color: var(--text-secondary);
            border: none;
            background: none;
            margin: -8px;
        }

        .modal-close:hover {
            color: var(--text-primary);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 20px;
            clear: both;
        }

        .score-breakdown {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 1px solid var(--border-color);
        }

        .breakdown-item {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
        }

        .breakdown-item-label {
            color: var(--text-secondary);
        }

        .breakdown-item-value {
            font-weight: 700;
            color: var(--text-primary);
        }

        .weights-title {
            font-size: 12px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .weight-item {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-bottom: 8px;
        }

        .illustrative-note {
            font-size: 11px;
            color: var(--text-secondary);
            font-style: italic;
            margin-top: 12px;
            padding-top: 12px;
            border-top: 1px solid var(--border-color);
        }

        .why-button {
            padding: 6px 12px;
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            cursor: pointer;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .why-button:hover {
            border-color: var(--kia-red);
            color: var(--kia-red);
        }

        /* FOOTER */
        .footer {
            padding: 12px 40px;
            background: rgba(0, 0, 0, 0.6);
            border-top: 1px solid var(--border-color);
            font-size: 10px;
            color: var(--text-secondary);
            text-align: center;
        }

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(255, 0, 0, 0.2);
            border-radius: 4px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: rgba(255, 0, 0, 0.4);
        }

        @media (max-width: 1400px) {
            .category-cards {
                grid-template-columns: repeat(2, 1fr);
            }
            .simulation-buttons {
                grid-template-columns: repeat(2, 1fr);
            }
            .journey-stages {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body>
    <div class="app-container">
        <!-- HEADER -->
        <div class="nav-header">
            <div class="nav-brand">
                <div class="nav-logo">🚗 KIA</div>
                <div class="nav-title">
                    <div class="nav-title-main">SALES PRIORITY</div>
                    <div class="nav-title-sub">Lead prioritisation cockpit</div>
                </div>
            </div>
            <div class="nav-meta">
                <div class="nav-date">27 Aug 2026 | Demo environment</div>
                <div class="nav-badge">Illustrative Prototype</div>
            </div>
        </div>

        <!-- CONTENT -->
        <div class="content-wrapper">
            <!-- MY LEADS VIEW -->
            <div class="view active" id="myLeadsView">
                <div class="summary-section">
                    <div>
                        <div class="summary-title">27 leads requiring attention</div>
                        <div style="font-size: 14px; color: var(--text-secondary); margin-top: 6px;">Prioritised by likelihood to convert</div>
                        <div class="summary-stats">
                            <div class="stat-item">
                                <span class="stat-badge hot"></span>
                                <span>3 <strong>HOT</strong></span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-badge warm"></span>
                                <span>8 <strong>WARM</strong></span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-badge cold"></span>
                                <span>16 <strong>COLD</strong></span>
                            </div>
                        </div>
                    </div>
                    <div class="demo-controls">
                        <button class="btn" onclick="switchPersona('aarav')">👤 Aarav (86)</button>
                        <button class="btn" onclick="switchPersona('mira')">👤 Mira (68)</button>
                        <button class="btn" onclick="switchPersona('rohan')">👤 Rohan (39)</button>
                        <button class="btn btn-primary" onclick="resetDemo()">↻ Reset</button>
                    </div>
                </div>

                <table class="leads-table">
                    <thead>
                        <tr>
                            <th>Lead Name</th>
                            <th>Model</th>
                            <th>Score</th>
                            <th>Priority</th>
                            <th>Last Activity</th>
                            <th>Recommended Action</th>
                        </tr>
                    </thead>
                    <tbody id="leadsTableBody">
                    </tbody>
                </table>
            </div>

            <!-- LEAD 360 VIEW -->
            <div class="view" id="lead360View">
                <div class="lead-header">
                    <div>
                        <div class="lead-name-header" id="lead360Name">Aarav Sharma</div>
                        <div class="lead-meta" id="lead360Meta">Seltos | Bengaluru | Individual</div>
                        <button class="btn" onclick="backToLeads()" style="margin-top: 16px;">← Back to Leads</button>
                    </div>
                    <div class="lead-header-right">
                        <div class="score-display">
                            <div class="score-number" id="lead360Score">86</div>
                            <div class="score-label">Lead Score</div>
                        </div>
                        <div class="priority-display">
                            <div class="priority-badge-large hot" id="lead360Priority">🔴 HOT</div>
                            <button class="why-button" onclick="openWhyModal()">Why?</button>
                        </div>
                        <div class="recommended-action">
                            <strong id="lead360Action">Call now</strong> — High purchase intent with recent engagement
                        </div>
                    </div>
                </div>

                <div class="category-cards" id="categoryCardsContainer"></div>

                <div class="section">
                    <div class="section-title">🎯 Top Contributing Signals</div>
                    <div class="signal-list" id="topSignalsList"></div>
                </div>

                <div class="section">
                    <div class="section-title">📍 Signal Journey</div>
                    <div class="journey-stages" id="journeyStagesContainer"></div>
                </div>

                <div class="simulation-section">
                    <div class="simulation-title">⚡ Simulate Next Prospect Activity</div>
                    <div class="simulation-subtitle">See how new signals can change lead priority</div>
                    <div class="simulation-buttons">
                        <button class="sim-button" onclick="addSignal(8, 'Test drive completed', 'purchase')">🚗 Test Drive +8</button>
                        <button class="sim-button" onclick="addSignal(7, 'Multiple dealer visits', 'purchase')">🏪 Dealer Visits +7</button>
                        <button class="sim-button" onclick="addSignal(5, 'Price discussion', 'purchase')">💰 Price Talk +5</button>
                        <button class="sim-button" onclick="addSignal(8, 'Price agreed', 'purchase')">✅ Price Set +8</button>
                        <button class="sim-button" onclick="addSignal(10, 'Booking initiated', 'purchase')">📋 Booking +10</button>
                        <button class="sim-button negative" onclick="addSignal(-3, '15+ days inactive', 'recency')">⏱️ Decay -3</button>
                    </div>
                    <div class="feedback hide" id="feedback"></div>
                </div>
            </div>
        </div>

        <!-- FOOTER -->
        <div class="footer">
            Illustrative prototype — signal availability, rules, weights and thresholds would be calibrated using Kia data and validated against historical conversion outcomes.
        </div>
    </div>

    <!-- MODAL -->
    <div class="modal" id="whyModal">
        <div class="modal-content">
            <button class="modal-close" onclick="closeWhyModal()">✕</button>
            <div class="modal-title">Lead Score Breakdown</div>
            <div class="score-breakdown" id="scoreBreakdownContainer"></div>
            <div class="weights-title">Illustrative Category Weights</div>
            <div id="weightsContainer"></div>
            <div class="illustrative-note">
                ℹ️ These weights are illustrative only. Actual weights would be calibrated using Kia's historical data.
            </div>
        </div>
    </div>

    <script>
        // DATA
        const personas = {
            aarav: {
                name: 'Aarav Sharma',
                model: 'Seltos',
                city: 'Bengaluru',
                type: 'Individual',
                baseScore: 86,
                description: 'Digital-first, decisive buyer | Working professional',
                signals: {
                    profileFit: { score: 18, max: 25, signals: ['Existing owner', 'Vehicle 5+ years old'] },
                    engagement: { score: 17, max: 20, signals: ['8 website visits', 'Configurator used', 'Multiple comparisons'] },
                    purchaseIntent: { score: 42, max: 45, signals: ['Finance inquiry', 'Dealer visits', 'Test drive request', 'Booking initiated'] },
                    recency: { score: 9, max: 10, signals: ['Activity in last 2 days'] }
                },
                topSignals: [
                    { text: 'Booking initiated', points: 10, width: '100%' },
                    { text: 'Test drive completed', points: 8, width: '80%' },
                    { text: 'Multiple dealer visits', points: 7, width: '70%' },
                    { text: 'Price discussion', points: 5, width: '50%' },
                    { text: '8 website visits', points: 10, width: '100%' }
                ],
                journey: {
